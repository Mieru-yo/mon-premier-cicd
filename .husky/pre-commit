repo_root=$(git rev-parse --show-toplevel 2> /dev/null | tr -d '\r')

if [ ! -f package.json ]; then
	echo "Warning: pre-commit executed outside project root, skipping local checks."
	exit 0
fi

if ! command -v docker > /dev/null 2>&1; then
	echo "Docker is required for local gitleaks pre-commit scan."
	exit 1
fi

if [ -n "${repo_root}" ]; then
	if command -v cygpath > /dev/null 2>&1; then
		repo_root=$(cygpath -m "${repo_root}")
	fi
	MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL="*" docker run --rm -v "${repo_root}:/repo" zricethezav/gitleaks:latest detect --source=/repo --no-git --redact
else
	echo "Warning: unable to resolve repository root in hook context, skipping local gitleaks scan."
fi

npm run lint
npm run format:check
